    "#var,cov,corr\n",
    "from sklearn.datasets import load_iris\n",
    "import pandas as pd\n",
    "\n",
    "iris=load_iris()\n",
    "\n",
    "data = pd.DataFrame(iris.data,columns=iris.feature_names)\n",
    "print(\"var\\n\",data.var())\n",
    "print(\"Corr\\n\",data.corr())\n",
    "print(\"Cov\\n\",data.cov())"
   ]
