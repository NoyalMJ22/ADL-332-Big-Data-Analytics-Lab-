     "output_type": "stream",
     "text": [
      "Enter sentence:  I tried and tried and tried again and again\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Map Output = [('I', 1), ('tried', 1), ('and', 1), ('tried', 1), ('and', 1), ('tried', 1), ('again', 1), ('and', 1), ('again', 1)]\n",
      "Word Count = 9\n"
     ]
    }
   ],
   "source": [
    "from functools import reduce\n",
    "\n",
    "text = input(\"Enter sentence: \")\n",
    "\n",
    "words = text.split()\n",
    "\n",
    "mapped = list(map(lambda x: (x,1), words))\n",
    "\n",
    "print(\"Map Output =\", mapped)\n",
    "\n",
    "count = reduce(lambda a,b: a+b,\n",
    "               [value for word,value in mapped])\n",
    "\n",
    "print(\"Word Count =\", count)"
   ]
  },
